{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-plan-approval/v1"
    },
    "specId": {
      "type": "string",
      "minLength": 1
    },
    "approvedAt": {
      "type": "string",
      "minLength": 1
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "planFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "specFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taskFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taskIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "specId",
    "approvedAt",
    "approvedBy",
    "planFingerprint",
    "approvalId",
    "specFingerprint",
    "taskFingerprint",
    "configFingerprint",
    "taskIds",
    "acceptanceIds",
    "verificationCommands"
  ],
  "additionalProperties": false
}

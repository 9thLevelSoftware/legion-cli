{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-dag/v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pr-[1-9]\\d*$"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^pr-[1-9]\\d*$"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tracesTo": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "implementing",
              "reviewing",
              "completed",
              "failed",
              "skipped"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "base": {
            "type": "string",
            "minLength": 1
          },
          "mergeIn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "commit": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "worktree": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "agentId": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewRounds": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "number",
          "title",
          "branch",
          "dependsOn",
          "files",
          "tracesTo",
          "risk",
          "spec",
          "status",
          "level",
          "base",
          "mergeIn"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "nodes"
  ],
  "additionalProperties": false
}

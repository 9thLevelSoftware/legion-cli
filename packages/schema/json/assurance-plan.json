{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-assurance-plan/v1"
    },
    "specId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "acceptanceIds": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "taskIds": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "information-flow",
            "adapter-default"
          ]
        },
        "sources": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
              },
              "classification": {
                "type": "string",
                "enum": [
                  "public",
                  "workspace",
                  "sealed"
                ]
              }
            },
            "required": [
              "id",
              "path",
              "classification"
            ],
            "additionalProperties": false
          }
        },
        "sinks": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "origin": {
                "type": "string",
                "maxLength": 4096,
                "format": "uri"
              },
              "classifications": {
                "minItems": 1,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "public",
                    "workspace",
                    "sealed"
                  ]
                }
              }
            },
            "required": [
              "id",
              "origin",
              "classifications"
            ],
            "additionalProperties": false
          }
        },
        "transformations": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "instruction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            },
            "required": [
              "id",
              "instruction"
            ],
            "additionalProperties": false
          }
        },
        "tasks": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "readPaths": {
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
                }
              },
              "transformationIds": {
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            },
            "required": [
              "taskId",
              "readPaths",
              "transformationIds"
            ],
            "additionalProperties": false
          }
        },
        "externalCalls": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "taskIds": {
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sinkId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "authority": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "dataPointers": {
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^(?:\\/(?:[^~]|~[01])*)*$"
                }
              },
              "effect": {
                "type": "string",
                "enum": [
                  "provider",
                  "http-mcp"
                ]
              }
            },
            "required": [
              "id",
              "taskIds",
              "tool",
              "sinkId",
              "authority",
              "dataPointers",
              "effect"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mode",
        "sources",
        "sinks",
        "transformations",
        "tasks",
        "externalCalls"
      ],
      "additionalProperties": false
    },
    "knowledge": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
              },
              "selector": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "function",
                      "class",
                      "method",
                      "type",
                      "interface",
                      "variable"
                    ]
                  },
                  "qualifiedName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "kind",
                  "qualifiedName"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "acceptanceIds": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "taskIds": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "dependsOn": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "checkIds": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "statement",
          "source",
          "acceptanceIds",
          "taskIds",
          "dependsOn",
          "checkIds"
        ],
        "additionalProperties": false
      }
    },
    "validators": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "extensionRef": {
            "type": "string",
            "pattern": "^extension:[a-z][a-z0-9-]{0,63}$"
          },
          "extensionCheckId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "componentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "inputUnitIds": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "inputFiles": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
            }
          },
          "acceptanceIds": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "configuration": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "id",
          "extensionRef",
          "extensionCheckId",
          "componentSha256",
          "inputUnitIds",
          "inputFiles",
          "acceptanceIds",
          "configuration"
        ],
        "additionalProperties": false
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "artifacts": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
              }
            },
            "required": [
              "name",
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "artifacts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "specId",
    "acceptanceIds",
    "taskIds",
    "security",
    "knowledge",
    "validators",
    "delivery"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}

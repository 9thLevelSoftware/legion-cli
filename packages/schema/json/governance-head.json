{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-governance-head/v1"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "incomplete",
        "invalid"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "approvalId",
    "sequence",
    "digest",
    "status"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-fingerprint/v1"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "enum": [
        "lsp",
        "fallback"
      ]
    },
    "rootHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modules": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.[Gg][Ii][Tt](?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.[Gg][Ii][Tt](?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
          },
          "language": {
            "type": "string",
            "enum": [
              "ts",
              "js",
              "py",
              "go",
              "rs",
              "other"
            ]
          },
          "exports": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "imports": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "language",
          "exports",
          "imports",
          "hash"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "backend",
    "rootHash",
    "modules"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-brief/v1"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "greenfield",
            "brownfield"
          ]
        },
        "controlMode": {
          "type": "string",
          "enum": [
            "guarded",
            "surgical",
            "advisory"
          ]
        }
      },
      "required": [
        "name",
        "mode",
        "controlMode"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "uninitialized",
        "initialized",
        "intent_draft",
        "intent_ready",
        "discussing",
        "spec_draft",
        "spec_frozen",
        "planning",
        "plan_failed",
        "plan_ready",
        "executing",
        "ready_to_ship",
        "shipped",
        "abandoned"
      ]
    },
    "currentTask": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "title"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "legion-cli-assumption/v1"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "confirmed",
              "rejected"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "escalatesTo": {
            "type": "string",
            "enum": [
              "user",
              "engineer"
            ]
          },
          "createdIn": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "statement",
          "status",
          "blocking",
          "escalatesTo",
          "createdIn"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "summary"
        ]
      }
    },
    "wiki": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "trust": {
            "type": "string",
            "enum": [
              "untrusted",
              "reviewed"
            ]
          }
        },
        "required": [
          "path",
          "title",
          "trust"
        ]
      }
    },
    "contract": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "filesAllowed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
              }
            },
            "filesForbidden": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\\\]+$"
              }
            },
            "expectedArtifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
              }
            },
            "verificationCommands": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "maxFilesTouched": {
              "default": 20,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "filesAllowed",
            "filesForbidden",
            "expectedArtifacts",
            "verificationCommands"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "lastQa": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "total": {
              "type": "number"
            },
            "pass": {
              "type": "boolean"
            }
          },
          "required": [
            "total",
            "pass"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "characterCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "phase",
    "blockers",
    "decisions",
    "wiki",
    "characterCount"
  ]
}

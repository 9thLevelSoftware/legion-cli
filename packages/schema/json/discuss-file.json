{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-discuss/v1"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "status"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "decisions"
  ]
}

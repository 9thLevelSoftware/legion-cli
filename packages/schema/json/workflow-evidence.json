{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-workflow-evidence/v1"
    },
    "specId": {
      "type": "string",
      "minLength": 1
    },
    "planFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "productFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environmentFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "blocked",
        "complete"
      ]
    },
    "completedTaskIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "integration": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          },
          "started": {
            "type": "boolean"
          },
          "status": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "timedOut": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "logPath": {
            "type": "string",
            "minLength": 1
          },
          "trustTier": {
            "type": "string",
            "minLength": 1
          },
          "trustTierNote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command",
          "ok",
          "started",
          "status",
          "trustTier",
          "trustTierNote"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "evidencePath": {
              "type": "string",
              "minLength": 1
            },
            "evidenceFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "verdict",
            "evidencePath",
            "evidenceFingerprint"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "blocker": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "specId",
    "planFingerprint",
    "approvalId",
    "productFingerprint",
    "environmentFingerprint",
    "status",
    "completedTaskIds",
    "integration",
    "review",
    "blocker",
    "updatedAt"
  ],
  "additionalProperties": false
}

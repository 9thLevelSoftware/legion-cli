{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-spec/v1"
    },
    "workflowPolicyVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "frozen",
        "superseded"
      ]
    },
    "mustBeTrue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mustNotChange": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "behavior",
              "test",
              "rubric"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "notApplicableWhen": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement",
          "kind",
          "priority"
        ]
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "happyPath": {
      "type": "string"
    },
    "failureCases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stories": {
      "type": [
        "string",
        "null"
      ]
    },
    "wireframesIndex": {
      "type": [
        "string",
        "null"
      ]
    },
    "frozenAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "frozenBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "rejected"
            ]
          },
          "planning": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "preference",
                  "fact",
                  "scope",
                  "design"
                ]
              },
              "blocking": {
                "type": "boolean"
              },
              "prerequisiteIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "observation",
                        "assumption",
                        "user_report",
                        "verified_execution"
                      ]
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "statement"
                  ],
                  "additionalProperties": false
                }
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "consequence": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "consequence"
                  ],
                  "additionalProperties": false
                }
              },
              "recommendedOptionId": {
                "type": "string",
                "minLength": 1
              },
              "resolution": {
                "type": "object",
                "properties": {
                  "disposition": {
                    "type": "string",
                    "enum": [
                      "answered",
                      "deferred",
                      "out_of_scope"
                    ]
                  },
                  "response": {
                    "type": "string",
                    "minLength": 1
                  },
                  "selectedOptionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resolvedAt": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "disposition",
                  "response",
                  "resolvedAt"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "name",
              "question",
              "kind",
              "blocking",
              "prerequisiteIds",
              "evidence",
              "options"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "statement",
          "status"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "mustBeTrue",
    "mustNotChange",
    "outOfScope",
    "acceptance",
    "personas",
    "happyPath"
  ]
}

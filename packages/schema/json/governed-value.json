{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "label": {
      "type": "object",
      "properties": {
        "origins": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "integrity": {
          "type": "string",
          "enum": [
            "approved",
            "untrusted"
          ]
        },
        "confidentiality": {
          "type": "string",
          "enum": [
            "public",
            "workspace",
            "sealed"
          ]
        }
      },
      "required": [
        "origins",
        "integrity",
        "confidentiality"
      ],
      "additionalProperties": false
    },
    "producer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "read"
            },
            "operationId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "operationId",
            "path",
            "sourceDigest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "derive"
            },
            "operationId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "transformationId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "inputIds": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "originalCallId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "required": [
            "kind",
            "operationId",
            "transformationId",
            "inputIds",
            "originalCallId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "external-call"
            },
            "operationId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "actionId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "required": [
            "kind",
            "operationId",
            "actionId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "retained": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "encoding": {
                  "type": "string",
                  "const": "utf8"
                },
                "content": {
                  "type": "string",
                  "maxLength": 1048576
                }
              },
              "required": [
                "encoding",
                "content"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "encoding": {
                  "type": "string",
                  "const": "base64"
                },
                "content": {
                  "type": "string",
                  "maxLength": 2097152,
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              },
              "required": [
                "encoding",
                "content"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "digest",
    "bytes",
    "label",
    "producer",
    "retained"
  ],
  "additionalProperties": false
}

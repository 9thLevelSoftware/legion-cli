{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-task/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "ready",
        "in_progress",
        "verifying",
        "blocked",
        "done",
        "compacted"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "fix",
        "bug"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "specId": {
      "type": "string",
      "minLength": 1
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "blockedBy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contract": {
      "type": "object",
      "properties": {
        "filesAllowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
          }
        },
        "filesForbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\]+$"
          }
        },
        "expectedArtifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
          }
        },
        "verificationCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxFilesTouched": {
          "default": 20,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "filesAllowed",
        "filesForbidden",
        "expectedArtifacts",
        "verificationCommands"
      ]
    },
    "assignee": {
      "type": "string",
      "enum": [
        "agent",
        "human"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "type",
    "priority",
    "specId",
    "blockedBy",
    "blocks",
    "contract",
    "assignee",
    "notes"
  ]
}

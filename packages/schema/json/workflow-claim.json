{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-workflow-claim/v1"
    },
    "token": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "processStartedAt": {
      "type": "number"
    },
    "claimedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "token",
    "pid",
    "processStartedAt",
    "claimedAt"
  ],
  "additionalProperties": false
}

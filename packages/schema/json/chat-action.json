{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "status"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "search"
            },
            "q": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "q"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "next_verb"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "intent_answer"
            },
            "answers": {
              "minItems": 1,
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "answers"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "discuss_decide"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "accepted",
                "rejected"
              ]
            }
          },
          "required": [
            "type",
            "id",
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ticket"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "parentId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "assume_answer"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "confirmed",
                "rejected"
              ]
            }
          },
          "required": [
            "type",
            "id",
            "status"
          ]
        }
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-brownfield-patterns/v1"
    },
    "patterns": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "firstSeen": {
            "type": "string",
            "minLength": 1
          },
          "lastSeen": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "count",
          "firstSeen",
          "lastSeen"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "patterns"
  ],
  "additionalProperties": false
}

    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "initialDraftFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contextFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositoryFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "finalDraftFingerprint": {

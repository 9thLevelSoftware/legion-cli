{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-qa/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "specId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "full",
        "no-browser"
      ]
    },
    "buckets": {
      "type": "object",
      "properties": {
        "p0": {
          "type": "object",
          "properties": {
            "points": {
              "type": "number"
            },
            "max": {
              "type": "number",
              "const": 40
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "points",
            "max",
            "failed"
          ]
        },
        "p1": {
          "type": "object",
          "properties": {
            "points": {
              "type": "number"
            },
            "max": {
              "type": "number",
              "const": 30
            },
            "passRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "points",
            "max",
            "passRate"
          ]
        },
        "p2": {
          "type": "object",
          "properties": {
            "points": {
              "type": "number"
            },
            "max": {
              "type": "number",
              "const": 15
            },
            "passRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "points",
            "max",
            "passRate"
          ]
        },
        "visual": {
          "type": "object",
          "properties": {
            "points": {
              "type": "number"
            },
            "max": {
              "type": "number",
              "const": 15
            },
            "regressions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "points",
            "max",
            "regressions"
          ]
        }
      },
      "required": [
        "p0",
        "p1",
        "p2",
        "visual"
      ]
    },
    "total": {
      "type": "number"
    },
    "pass": {
      "type": "boolean"
    },
    "evidencePaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "specId",
    "mode",
    "buckets",
    "total",
    "pass",
    "evidencePaths",
    "createdAt"
  ]
}

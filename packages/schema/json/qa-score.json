{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "specId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "full",
        "no-browser"
      ]
    },
    "buckets": {
      "type": "object",
      "properties": {
        "p0": {
          "type": "object",
          "properties": {
            "points": {
              "type": "number"
            },
            "max": {
              "type": "number",
              "const": 40
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "points",
            "max",
            "failed"
          ]
        },
        "p1": {
          "type": "object",
          "properties": {
            "points": {
              "type": "number"
            },
            "max": {
              "type": "number",
              "const": 30
            },
            "passRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "points",
            "max",
            "passRate"
          ]
        },
        "p2": {
          "type": "object",
          "properties": {
            "points": {
              "type": "number"
            },
            "max": {
              "type": "number",
              "const": 15
            },
            "passRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "points",
            "max",
            "passRate"
          ]
        },
        "visual": {
          "type": "object",
          "properties": {
            "points": {
              "type": "number"
            },
            "max": {
              "type": "number",
              "const": 15
            },
            "regressions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "points",
            "max",
            "regressions"
          ]
        }
      },
      "required": [
        "p0",
        "p1",
        "p2",
        "visual"
      ]
    },
    "total": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "pass": {
      "type": "boolean"
    },
    "evidencePaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-qa/v2"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "missing"
            ]
          }
        },
        "required": [
          "id",
          "priority",
          "outcome"
        ]
      }
    },
    "missingCriterionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failedCriterionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skippedCriterionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reportFailures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "specHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "usage": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimatedCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "costEstimated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "specId",
    "mode",
    "buckets",
    "total",
    "pass",
    "evidencePaths",
    "createdAt",
    "schemaVersion",
    "criteria",
    "missingCriterionIds",
    "failedCriterionIds",
    "skippedCriterionIds",
    "reportFailures",
    "specHash",
    "sourceHash"
  ],
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "full"
          },
          "total": {
            "minimum": 85
          },
          "buckets": {
            "type": "object",
            "properties": {
              "p0": {
                "type": "object",
                "properties": {
                  "failed": {
                    "const": 0
                  }
                },
                "required": [
                  "failed"
                ]
              },
              "visual": {
                "type": "object",
                "properties": {
                  "regressions": {
                    "const": 0
                  }
                },
                "required": [
                  "regressions"
                ]
              }
            },
            "required": [
              "p0",
              "visual"
            ]
          }
        },
        "required": [
          "mode",
          "total",
          "buckets"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "pass": {
            "const": true
          }
        },
        "required": [
          "pass"
        ]
      },
      "else": {
        "type": "object",
        "properties": {
          "pass": {
            "const": false
          }
        },
        "required": [
          "pass"
        ]
      }
    }
  ]
}

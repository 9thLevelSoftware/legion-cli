{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "skillId": {
          "type": "string",
          "enum": [
            "interview",
            "discuss",
            "spec",
            "spec-challenge",
            "ingest",
            "plan",
            "execute",
            "verify",
            "review",
            "qa",
            "map",
            "wireframe",
            "chat"
          ]
        },
        "preSpawnRef": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "enginePid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "adapterId": {
          "type": "string",
          "enum": [
            "claude",
            "generic",
            "fake",
            "grok",
            "openai",
            "codex",
            "mimo",
            "minimax",
            "http",
            "acp"
          ]
        },
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "argvSummary": {
          "type": "string"
        },
        "resolutionSource": {
          "type": "string",
          "enum": [
            "cli",
            "profile",
            "task",
            "skill-profile",
            "route",
            "default"
          ]
        },
        "schemaVersion": {
          "type": "string",
          "const": "legion-cli-resume/v2"
        },
        "stage": {
          "type": "string",
          "enum": [
            "starting",
            "running",
            "agent-complete",
            "integrating",
            "verifying",
            "completed",
            "blocked",
            "interrupted"
          ]
        },
        "stageUpdatedAt": {
          "type": "string",
          "minLength": 1
        },
        "pidStartedAt": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "enginePidStartedAt": {
          "type": "number",
          "minimum": 0
        },
        "engineOwnershipReleasedAt": {
          "type": "string",
          "minLength": 1
        },
        "childTerminationUncertain": {
          "type": "boolean"
        },
        "logs": {
          "type": "object",
          "properties": {
            "stdout": {
              "type": "string",
              "minLength": 1
            },
            "stderr": {
              "type": "string",
              "minLength": 1
            },
            "verification": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "stdout",
            "stderr"
          ],
          "additionalProperties": false
        },
        "interruptionReason": {
          "type": "string",
          "minLength": 1
        },
        "recoveryCommand": {
          "type": "string",
          "minLength": 1
        },
        "sourceIdentity": {
          "type": "string",
          "minLength": 1
        },
        "contractIdentity": {
          "type": "string",
          "minLength": 1
        },
        "jailIdentity": {
          "type": "string",
          "minLength": 1
        },
        "checkpointPath": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "toolCalls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "estimatedCostUsd": {
              "type": "number",
              "minimum": 0
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "costEstimated": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "runId",
        "skillId",
        "preSpawnRef",
        "startedAt",
        "schemaVersion",
        "stage",
        "stageUpdatedAt",
        "enginePidStartedAt",
        "logs"
      ]
    },
    {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "skillId": {
          "type": "string",
          "enum": [
            "interview",
            "discuss",
            "spec",
            "spec-challenge",
            "ingest",
            "plan",
            "execute",
            "verify",
            "review",
            "qa",
            "map",
            "wireframe",
            "chat"
          ]
        },
        "preSpawnRef": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "enginePid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "adapterId": {
          "type": "string",
          "enum": [
            "claude",
            "generic",
            "fake",
            "grok",
            "openai",
            "codex",
            "mimo",
            "minimax",
            "http",
            "acp"
          ]
        },
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "argvSummary": {
          "type": "string"
        },
        "resolutionSource": {
          "type": "string",
          "enum": [
            "cli",
            "profile",
            "task",
            "skill-profile",
            "route",
            "default"
          ]
        },
        "schemaVersion": {
          "type": "string",
          "const": "legion-cli-resume/v1"
        }
      },
      "required": [
        "runId",
        "skillId",
        "preSpawnRef",
        "startedAt",
        "schemaVersion"
      ]
    }
  ]
}

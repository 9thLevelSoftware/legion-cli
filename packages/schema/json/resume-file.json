{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-resume/v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "skillId": {
      "type": "string",
      "enum": [
        "interview",
        "discuss",
        "spec",
        "ingest",
        "plan",
        "execute",
        "verify",
        "review",
        "qa"
      ]
    },
    "preSpawnRef": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "skillId",
    "preSpawnRef",
    "startedAt"
  ]
}

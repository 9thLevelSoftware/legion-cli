{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-serve/v1"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "bind": {
      "type": "string",
      "minLength": 1
    },
    "mcpPath": {
      "type": "string",
      "const": "/mcp"
    },
    "mcpHttp": {
      "type": "boolean"
    },
    "tokenSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "port",
    "bind",
    "mcpPath",
    "mcpHttp",
    "tokenSha256",
    "startedAt",
    "pid"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "skillId": {
      "type": "string",
      "enum": [
        "interview",
        "discuss",
        "spec",
        "spec-challenge",
        "ingest",
        "plan",
        "execute",
        "verify",
        "review",
        "qa",
        "map",
        "wireframe",
        "chat"
      ]
    },
    "allowedRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\\\]+$"
      }
    }
  },
  "required": [
    "skillId",
    "allowedRoots"
  ]
}

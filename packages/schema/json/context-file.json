{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-context/v1"
    },
    "standingInstructions": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "phone",
          "desktop"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "standingInstructions",
    "platforms"
  ]
}

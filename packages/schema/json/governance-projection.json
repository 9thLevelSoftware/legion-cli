{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-governance-projection/v1"
    },
    "phase": {
      "type": "string",
      "enum": [
        "uninitialized",
        "initialized",
        "intent_draft",
        "intent_ready",
        "discussing",
        "spec_draft",
        "spec_frozen",
        "planning",
        "plan_failed",
        "plan_ready",
        "executing",
        "ready_to_ship",
        "shipped",
        "abandoned"
      ]
    },
    "controlMode": {
      "type": "string",
      "enum": [
        "guarded",
        "advisory"
      ]
    },
    "tasks": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "ready",
              "in_progress",
              "verifying",
              "blocked",
              "done",
              "compacted"
            ]
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "writes": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?!\\/)(?:(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)(?:\\/(?!\\.git(?:\\/|$))(?!\\.(?:\\/|$))(?!\\.\\.(?:\\/|$))[^\\\\*?[\\]/]+)*$"
            }
          },
          "checks": {
            "type": "string",
            "enum": [
              "not-run",
              "running",
              "passed",
              "failed",
              "unavailable",
              "stale"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "owner",
          "writes",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "freshness"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "owner": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "liveness": {
          "type": "string",
          "enum": [
            "none",
            "live",
            "dead",
            "unknown"
          ]
        }
      },
      "required": [
        "owner",
        "liveness"
      ],
      "additionalProperties": false
    },
    "integration": {
      "type": "string",
      "enum": [
        "not-run",
        "running",
        "passed",
        "failed",
        "unavailable",
        "stale"
      ]
    },
    "components": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "not-run",
              "running",
              "passed",
              "failed",
              "unavailable",
              "stale"
            ]
          }
        },
        "required": [
          "checkId",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "string",
      "enum": [
        "not-run",
        "running",
        "passed",
        "failed",
        "unavailable",
        "stale"
      ]
    },
    "acceptance": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "type": "string",
            "enum": [
              "not-recorded",
              "passed",
              "failed",
              "unknown"
            ]
          },
          "freshness": {
            "type": "string",
            "enum": [
              "current",
              "stale",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "freshness"
        ],
        "additionalProperties": false
      }
    },
    "sourceFingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceFingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ship": {
      "type": "object",
      "properties": {
        "confirmationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "previewFingerprint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "none",
            "prepared",
            "complete",
            "aborted"
          ]
        }
      },
      "required": [
        "confirmationId",
        "previewFingerprint",
        "confirmed",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "phase",
    "controlMode",
    "tasks",
    "approval",
    "claim",
    "integration",
    "components",
    "review",
    "acceptance",
    "sourceFingerprint",
    "evidenceFingerprint",
    "ship"
  ],
  "additionalProperties": false
}

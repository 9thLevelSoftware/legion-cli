{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-acceptance-receipt/v1"
    },
    "specId": {
      "type": "string",
      "minLength": 1
    },
    "planFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "productFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recordedAt": {
      "type": "string",
      "minLength": 1
    },
    "recordedBy": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_applicable"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "specId",
    "planFingerprint",
    "approvalId",
    "productFingerprint",
    "recordedAt",
    "recordedBy",
    "entries"
  ],
  "additionalProperties": false
}

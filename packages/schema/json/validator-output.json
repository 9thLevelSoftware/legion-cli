{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "legion-cli-validator-output/v1"
    },
    "checkId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "observations": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "error"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "detail": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "status",
          "code"
        ],
        "additionalProperties": false
      }
    },
    "recommendations": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "feature",
              "fix",
              "bug"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "checkId",
    "status",
    "observations"
  ],
  "additionalProperties": false
}

{
  "name": "@9thlevelsoftware/legion-cli-persist",
  "version": "0.0.0",
  "description": "Legion CLI persistence (markdown, git, sqlite, lock)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-trust-roots.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.js",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9thLevelSoftware/product-engineer-helper.git",
    "directory": "packages/persist"
  },
  "author": {
    "name": "9thLevelSoftware",
    "url": "https://github.com/9thLevelSoftware"
  },
  "keywords": [
    "legion",
    "legion-cli",
    "persist",
    "sqlite"
  ],
  "dependencies": {
    "@9thlevelsoftware/legion-cli-schema": "workspace:*",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "better-sqlite3": "^12.4.1",
    "yaml": "^2.9.0",
    "yauzl": "^2.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/yauzl": "^3.4.0"
  }
}
